[Unit]
Description=Feeder Remote Worker
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/feeder-worker
EnvironmentFile=%h/feeder-worker/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=%h/feeder-worker/venv/bin/python -m app.main
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
KillMode=control-group
UMask=0077
NoNewPrivileges=true
MemoryHigh=640M
MemoryMax=768M
MemorySwapMax=128M
TasksMax=128
OOMPolicy=stop
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
