[Unit]
Description=Feeder Remote Worker
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=WORKER_USER
Group=WORKER_GROUP
WorkingDirectory=/path/to/feeder-worker
EnvironmentFile=/path/to/feeder-worker/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/path/to/feeder-worker/venv/bin/python -m app.main
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
MemoryHigh=640M
MemoryMax=768M
MemorySwapMax=128M
TasksMax=128
OOMPolicy=stop
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
