# 실제 .env에는 32자 이상의 무작위 토큰을 지정하고 권한을 600으로 설정한다.
WORKER_API_TOKEN=
WORKER_BIND=127.0.0.1
WORKER_PORT=8000
# DB는 생략하면 설치 폴더의 data/worker.db를 사용한다.
WORKER_RCLONE_BINARY=/usr/bin/rclone
# 실제 절대 경로를 지정한다. 설치 프로그램은 현재 사용자의 경로를 자동 확인한다.
WORKER_RCLONE_CONFIG=/path/to/rclone.conf
WORKER_THREADS=8
WORKER_MAX_REQUEST_BYTES=65536
WORKER_LOG_LEVEL=INFO
# 실제 Rclone 리모트 이름을 사용한다. 소스는 WebDAV, 목적지는 Drive만 허용한다.
WORKER_SOURCE_REMOTES=source_remote
WORKER_DESTINATION_REMOTES=destination_remote
# DB 최초 생성 시의 초기값이다. 이후에는 GET/PUT /api/v1/config로 관리한다.
WORKER_MAX_CONCURRENT_JOBS=1
# 보관 범위를 벗어난 재연결에는 REST 재동기화가 필요하다.
WORKER_EVENT_RETENTION=2000
WORKER_SSE_MAX_CLIENTS=1
WORKER_SSE_HEARTBEAT_SECONDS=15
